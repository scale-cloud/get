# Install the Scale CLI and VM lib image on Windows.
#   irm https://raw.githubusercontent.com/scale-cloud/get/main/install.pwsh | iex
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

if ($env:OS -ne 'Windows_NT') {
    throw 'install.pwsh supports Windows. On Linux and Mac, run install.sh instead.'
}

$missing = @()
foreach ($name in @('docker', 'terraform')) {
    if (-not (Get-Command $name -ErrorAction SilentlyContinue)) {
        $missing += $name
    }
}
if ($missing.Count -gt 0) {
    throw "$($missing -join ' and ') is required but was not found on PATH."
}

Write-Host "Docker and Terraform are in path ✅"

$releaseBase = 'https://github.com/scale-cloud/get/releases/latest/download'
# /releases/latest/download redirects to /releases/download/<version>/...
$location = & curl.exe -s -o NUL -w '%{redirect_url}' "$releaseBase/scale-lib-linux-amd64.tar.gz"
if ($location -notmatch '/releases/download/([^/]+)/') {
    throw 'could not determine the latest Scale release'
}
$version = $Matches[1]
Write-Host "Installing Scale $version..."
Write-Host "" 

switch ($env:PROCESSOR_ARCHITECTURE) {
    'AMD64' { $triple = 'x86_64-pc-windows-msvc' }
    'ARM64' { throw 'There is no Windows on ARM build of Scale yet.\nIf you need this, contact the Scale development team: https://github.com/scale-cloud/get/issues' }
    default { throw "unsupported architecture: $env:PROCESSOR_ARCHITECTURE" }
}

$binDir = Join-Path $env:LOCALAPPDATA 'Programs\scale'
New-Item -ItemType Directory -Force -Path $binDir | Out-Null
$exe = Join-Path $binDir 'scale.exe'
& curl.exe -fL --retry 3 -o $exe "$releaseBase/scale-$triple.exe"
if ($LASTEXITCODE -ne 0) {
    throw "failed to download scale-$triple.exe"
}

$libDir = Join-Path $env:USERPROFILE '.scale\lib'
New-Item -ItemType Directory -Force -Path $libDir | Out-Null
$gz = Join-Path $libDir 'scale-lib-linux-amd64.tar.gz'
$tar = Join-Path $libDir 'scale-lib-linux-amd64.tar'
& curl.exe -fL --retry 3 -o $gz "$releaseBase/scale-lib-linux-amd64.tar.gz"
if ($LASTEXITCODE -ne 0) {
    throw 'failed to download scale-lib-linux-amd64.tar.gz'
}

Add-Type -AssemblyName System.IO.Compression
$inStream = [System.IO.File]::OpenRead($gz)
try {
    $gzip = New-Object System.IO.Compression.GZipStream(
        $inStream,
        [System.IO.Compression.CompressionMode]::Decompress)
    try {
        $outStream = [System.IO.File]::Create($tar)
        try {
            $gzip.CopyTo($outStream)
        } finally {
            $outStream.Dispose()
        }
    } finally {
        $gzip.Dispose()
    }
} finally {
    $inStream.Dispose()
}
Remove-Item $gz

Write-Host ""
$userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
$already = $false
if ($userPath) {
    foreach ($entry in ($userPath -split ';')) {
        if ($entry.TrimEnd('\') -ieq $binDir.TrimEnd('\')) {
            $already = $true
        }
    }
}
if (-not $already) {
    $newPath = if ($userPath) { "$userPath;$binDir" } else { $binDir }
    [Environment]::SetEnvironmentVariable('Path', $newPath, 'User')
    Write-Host "Added $binDir to your user PATH. Open a new terminal to use Scale."
}

Write-Host "Scale $version installed successfully! ✅"
